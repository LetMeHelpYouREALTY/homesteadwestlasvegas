# Copy to .env.local for development. Set in Vercel Project → Environment Variables for production.

# Production site URL is defined in lib/site-contact.ts (metadataBase, sitemap, robots, JSON-LD).

# Google Search Console — HTML tag verification token only (not the full meta tag).
# GSC → Settings → Ownership verification → HTML tag → paste the content value.
# https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=

# Cloudflare Images (hosted). Git JPEGs in /public/photos remain the backup.
# Hash is public (in every delivery URL). Token is secret — Images Write only.
# Do not orange-cloud the Vercel production hostname.
NEXT_PUBLIC_CF_IMAGES_HASH=byE6BTe9lNqo21V57n4aPQ
NEXT_PUBLIC_CF_IMAGES_VARIANT=public
NEXT_PUBLIC_CF_IMAGES_CUSTOM_DOMAIN=
NEXT_PUBLIC_CF_IMAGE_RESIZING=
CLOUDFLARE_ACCOUNT_ID=2cc579c1ec9e426ed585e933ebf4753b
CLOUDFLARE_API_TOKEN=

# Follow Up Boss — used by POST /api/leads/submit when a visitor sends the form
FOLLOW_UP_BOSS_BASE_URL=https://api.followupboss.com/v1
FOLLOW_UP_BOSS_API_KEY=
